{
  "qbpkg": "1.0",
  "manifest": {
    "id": "ct.login",
    "name": "中国电信登录助手",
    "version": "1.0.0",
    "engine": ">=1.0 <2.0",
    "author": "protocol-reverse",
    "description": "中国电信天翼账号登录：手机号 -> 图形验证码(按需) -> 短信验证码 -> 轮询短信状态 -> RSA 加密登录，产出原始 androidId 与 +2 位移转换 ID。",
    "allowHosts": [
      "appgo.189.cn:9200",
      "appgologin.189.cn:9031"
    ],
    "inputs": [
      {
        "key": "phone",
        "label": "中国电信手机号",
        "type": "phone",
        "required": true,
        "maxLength": 11,
        "placeholder": "请输入 11 位手机号"
      },
      {
        "key": "remark",
        "label": "备注密码（可选）",
        "type": "text",
        "required": false,
        "maxLength": 32,
        "placeholder": "自定义密码备注，如：Abc12345"
      }
    ],
    "vars": {
      "deviceModel": "{{fn.randomOf(env.deviceModels)}}",
      "androidId": "{{fn.randomHex(16)}}",
      "ua": "{{fn.concat(vars.deviceModel, '/11.0.0')}}",
      "clientType": "{{fn.concat('#11.0.0#channel35#', vars.deviceModel, '#')}}",
      "rsaPub": "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDBkLT15ThVgz6/NOl6s8GNPofdWzWbCkWnkaAm7O2LjkM1H7dMvzkiqdxU02jamGRHLX/ZNMCXHnPcW/sDhiFCBN18qFvy8g6VYb9QtroI09e176s+ZCtiv7hbin2cCTj99iUpnEloZm19lwHyo69u5UMiPMpq0/XKBO8lYhN/gwIDAQAB",
      "loginModel": "Xiaomi M2013",
      "encPhone": "{{fn.shift2(input.phone)}}",
      "encAndroidId": "{{fn.shift2(vars.androidId)}}",
      "smsId": "",
      "ts": "",
      "encSmsCode": "",
      "plain": "",
      "cipher": ""
    },
    "flow": [
      {
        "id": "sendInit",
        "type": "request",
        "branch": [
          {
            "when": "steps.sendInit.code == '1016'",
            "goto": "getCaptcha"
          },
          {
            "when": "steps.sendInit.code == '0000'",
            "goto": "useInitSms"
          }
        ],
        "request": {
          "method": "POST",
          "url": "https://appgologin.189.cn:9031/login/client/getLoginRandomCode",
          "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json; charset=UTF-8",
            "User-Agent": "{{vars.ua}}"
          },
          "body": {
            "type": "json",
            "value": {
              "headerInfos": {
                "code": "getLoginRandomCode",
                "timestamp": "{{fn.ts14()}}",
                "clientType": "{{vars.clientType}}",
                "shopId": "20002",
                "source": "110003",
                "sourcePassword": "Sid98s",
                "token": "",
                "userLoginName": ""
              },
              "content": {
                "attach": "test",
                "fieldData": {
                  "payType": "",
                  "phoneNum": "{{vars.encPhone}}",
                  "validationCode": "",
                  "imsi": "",
                  "salesProdId": "",
                  "key": "",
                  "androidId": "{{vars.encAndroidId}}",
                  "scene": "55"
                }
              }
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "code",
            "from": "json",
            "path": "$.responseData.resultCode",
            "optional": true,
            "default": ""
          },
          {
            "name": "desc",
            "from": "json",
            "path": "$.responseData.resultDesc",
            "optional": true,
            "default": ""
          },
          {
            "name": "smsId",
            "from": "regex",
            "pattern": "[{,]\\s*\\\\?\"smsId\\\\?\"\\s*:\\s*\\\\?\"([^\\\\\",}]+)",
            "group": 1,
            "optional": true,
            "default": ""
          }
        ],
        "assert": {
          "json": "$.responseData.resultCode",
          "matches": "^(0000|1016)$",
          "message": "无法创建登录流程"
        },
        "onFail": {
          "message": "无法创建登录流程：{{response.message}}"
        }
      },
      {
        "id": "getCaptcha",
        "type": "request",
        "request": {
          "method": "POST",
          "url": "https://appgo.189.cn:9200/query/getValidationCode",
          "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json; charset=UTF-8",
            "User-Agent": "{{vars.ua}}"
          },
          "body": {
            "type": "json",
            "value": {
              "headerInfos": {
                "code": "getValidationCode",
                "timestamp": "{{fn.ts14()}}",
                "clientType": "{{vars.clientType}}",
                "shopId": "20002",
                "source": "110003",
                "sourcePassword": "Sid98s",
                "token": "",
                "userLoginName": ""
              },
              "content": {
                "attach": "test",
                "fieldData": {}
              }
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "code",
            "from": "json",
            "path": "$.responseData.resultCode",
            "optional": true,
            "default": ""
          },
          {
            "name": "key",
            "from": "regex",
            "pattern": "[{,]\\s*\\\\?\"key\\\\?\"\\s*:\\s*\\\\?\"([^\\\\\",}]+)",
            "group": 1
          },
          {
            "name": "image",
            "from": "regex",
            "pattern": "[{,]\\s*\\\\?\"image\\\\?\"\\s*:\\s*\\\\?\"([^\\\\\",}]+)",
            "group": 1,
            "optional": true,
            "default": ""
          },
          {
            "name": "desc",
            "from": "json",
            "path": "$.responseData.resultDesc",
            "optional": true,
            "default": ""
          }
        ],
        "assert": {
          "json": "$.responseData.resultCode",
          "equals": "0000",
          "message": "图形验证码获取失败"
        },
        "onFail": {
          "message": "图形验证码获取失败：{{response.message}}"
        }
      },
      {
        "id": "askCaptcha",
        "type": "ui",
        "ui": {
          "type": "image",
          "label": "图形验证码（点击图片可刷新）",
          "input": "captchaCode",
          "maxLength": 4,
          "pattern": "^\\S{4}$",
          "image": "{{steps.getCaptcha.image}}",
          "refreshStep": "getCaptcha",
          "hint": "请输入 4 位图形验证码（字母或数字均可）"
        }
      },
      {
        "id": "sendSms",
        "type": "request",
        "request": {
          "method": "POST",
          "url": "https://appgologin.189.cn:9031/login/client/getLoginRandomCode",
          "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json; charset=UTF-8",
            "User-Agent": "{{vars.ua}}"
          },
          "body": {
            "type": "json",
            "value": {
              "headerInfos": {
                "code": "getLoginRandomCode",
                "timestamp": "{{fn.ts14()}}",
                "clientType": "{{vars.clientType}}",
                "shopId": "20002",
                "source": "110003",
                "sourcePassword": "Sid98s",
                "token": "",
                "userLoginName": ""
              },
              "content": {
                "attach": "test",
                "fieldData": {
                  "payType": "",
                  "phoneNum": "{{vars.encPhone}}",
                  "validationCode": "{{fn.trim(input.captchaCode)}}",
                  "imsi": "",
                  "salesProdId": "",
                  "key": "{{steps.getCaptcha.key}}",
                  "androidId": "{{vars.encAndroidId}}",
                  "scene": "55"
                }
              }
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "code",
            "from": "json",
            "path": "$.responseData.resultCode",
            "optional": true,
            "default": ""
          },
          {
            "name": "desc",
            "from": "json",
            "path": "$.responseData.resultDesc",
            "optional": true,
            "default": ""
          },
          {
            "name": "smsId",
            "from": "regex",
            "pattern": "[{,]\\s*\\\\?\"smsId\\\\?\"\\s*:\\s*\\\\?\"([^\\\\\",}]+)",
            "group": 1,
            "optional": true,
            "default": ""
          }
        ],
        "assert": {
          "json": "$.responseData.resultCode",
          "equals": "0000",
          "message": "短信发送失败"
        },
        "onFail": {
          "message": "短信发送失败：{{response.message}}"
        }
      },
      {
        "id": "useSentSms",
        "type": "set",
        "goto": "askSms",
        "set": {
          "vars": {
            "smsId": "{{steps.sendSms.smsId}}"
          }
        }
      },
      {
        "id": "useInitSms",
        "type": "set",
        "goto": "askSms",
        "set": {
          "vars": {
            "smsId": "{{steps.sendInit.smsId}}"
          }
        }
      },
      {
        "id": "askSms",
        "type": "ui",
        "ui": {
          "type": "text",
          "label": "短信验证码",
          "input": "smsCode",
          "maxLength": 6,
          "pattern": "^\\d{6}$",
          "hint": "短信已发送，请输入 6 位验证码"
        },
        "goto": "pollSms"
      },
      {
        "id": "smsStatus",
        "type": "request",
        "request": {
          "method": "POST",
          "url": "https://appgologin.189.cn:9031/login/client/getSmsIdStatus",
          "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json; charset=UTF-8",
            "User-Agent": "{{vars.ua}}"
          },
          "body": {
            "type": "json",
            "value": {
              "headerInfos": {
                "code": "getSmsIdStatus",
                "timestamp": "{{fn.ts14()}}",
                "clientType": "{{vars.clientType}}",
                "shopId": "20002",
                "source": "110003",
                "sourcePassword": "Sid98s",
                "token": "",
                "userLoginName": ""
              },
              "content": {
                "attach": "test",
                "fieldData": {
                  "smsId": "{{vars.smsId}}"
                }
              }
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "code",
            "from": "json",
            "path": "$.responseData.resultCode",
            "optional": true,
            "default": ""
          },
          {
            "name": "smsIdStatue",
            "from": "regex",
            "pattern": "[{,]\\s*\\\\?\"smsIdStatue\\\\?\"\\s*:\\s*\\\\?\"?([0-9]+)",
            "group": 1,
            "optional": true,
            "default": "0"
          },
          {
            "name": "desc",
            "from": "json",
            "path": "$.responseData.resultDesc",
            "optional": true,
            "default": ""
          }
        ],
        "assert": {
          "json": "$.responseData.resultCode",
          "equals": "0000",
          "message": "短信状态查询失败"
        },
        "onFail": {
          "message": "短信状态查询失败：{{response.message}}"
        }
      },
      {
        "id": "pollSms",
        "type": "poll",
        "poll": {
          "steps": [
            "smsStatus"
          ],
          "until": "steps.smsStatus.smsIdStatue == '1'",
          "intervalMs": 1000,
          "maxAttempts": 5,
          "onTimeout": {
            "message": "短信状态尚未就绪"
          }
        }
      },
      {
        "id": "setLoginVars",
        "type": "set",
        "set": {
          "vars": {
            "ts": "{{fn.ts14()}}",
            "encSmsCode": "{{fn.shift2(fn.trim(input.smsCode))}}",
            "plain": "{{fn.concat(fn.padRight(fn.substring(vars.loginModel, 0, 12), 12, '$'), fn.repeat('$', 15), fn.padRight(fn.substring(input.phone, 0, 11), 11, '$'), vars.ts, fn.padRight(fn.substring(fn.trim(input.smsCode), 0, 6), 6, '$'), fn.repeat('$', 6))}}",
            "cipher": "{{fn.rsaPkcs1(vars.rsaPub, vars.plain)}}"
          }
        }
      },
      {
        "id": "doLogin",
        "type": "request",
        "end": true,
        "request": {
          "method": "POST",
          "url": "https://appgologin.189.cn:9031/login/client/userLoginNormal",
          "headers": {
            "Accept": "application/json",
            "Content-Type": "application/json; charset=UTF-8",
            "User-Agent": "{{vars.ua}}"
          },
          "body": {
            "type": "json",
            "value": {
              "headerInfos": {
                "code": "userLoginNormal",
                "timestamp": "{{vars.ts}}",
                "clientType": "{{vars.clientType}}",
                "shopId": "20002",
                "source": "110003",
                "sourcePassword": "Sid98s",
                "token": "",
                "userLoginName": "{{vars.encPhone}}"
              },
              "content": {
                "attach": "test",
                "fieldData": {
                  "loginType": "2",
                  "accountType": "",
                  "loginAuthCipherAsymmertric": "{{vars.cipher}}",
                  "deviceUid": "",
                  "phoneNum": "{{vars.encPhone}}",
                  "isChinatelecom": "0",
                  "systemVersion": "13",
                  "androidId": "{{vars.encAndroidId}}",
                  "loginAuthCipher": "",
                  "authentication": "{{vars.encSmsCode}}"
                }
              }
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "code",
            "from": "json",
            "path": "$.responseData.resultCode",
            "optional": true,
            "default": ""
          },
          {
            "name": "desc",
            "from": "json",
            "path": "$.responseData.resultDesc",
            "optional": true,
            "default": ""
          }
        ],
        "assert": {
          "json": "$.responseData.resultCode",
          "equals": "0000",
          "message": "登录失败"
        },
        "onFail": {
          "message": "登录失败：{{response.message}}"
        }
      }
    ],
    "output": {
      "title": "电信登录凭证",
      "fields": [
        {
          "label": "Android ID（原始）",
          "value": "{{vars.androidId}}",
          "copyable": true,
          "sensitive": false,
          "multiline": false
        },
        {
          "label": "Android ID（转换后 +2 编码）",
          "value": "{{vars.encAndroidId}}",
          "copyable": true,
          "sensitive": false,
          "multiline": false
        },
        {
          "label": "导出（手机号#备注#转换ID）",
          "value": "{{fn.concat(input.phone, '#', fn.default(input.remark, '密码'), '#', vars.encAndroidId)}}",
          "copyable": true,
          "sensitive": false,
          "multiline": false
        }
      ]
    }
  },
  "meta": {
    "exportedAt": "2026-10-21T05:43:28Z",
    "exportedBy": "登录插件框架",
    "note": "plugin-harbor build_index.py"
  }
}