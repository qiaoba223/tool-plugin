{
  "qbpkg": "1.0",
  "manifest": {
    "id": "zto.member",
    "name": "中通会员助手",
    "version": "1.3.0",
    "engine": ">=1.0 <2.0",
    "author": "protocol-reverse",
    "description": "中通会员三条链路：①密码登录 ②短信注册 ③短信找回密码。直连 hdgateway.zto.com + mapi.zto.com，完整保留 PC 端伪装头（Origin/Referer/桌面 Chrome UA/x-clientCode/x-token）；「安全验证」为顶象滑块，走 CONTRACT.md §4.4.1 的 ui.type=webview：内联 HTML 加载 cdn.dingxiang-inc.com 的 captcha-ui v5，JS 回传 token 作为 x-captcha-code；x-captcha-id 仍取 mapi 的 captcha/image2 下发的 id。",
    "allowHosts": [
      "hdgateway.zto.com",
      "mapi.zto.com",
      "cdn.dingxiang-inc.com",
      "cap-8.dingxiang-inc.com"
    ],
    "inputs": [
      {
        "key": "mode",
        "label": "操作模式",
        "type": "select",
        "required": false,
        "default": "1",
        "options": [
          {
            "value": "1",
            "label": "密码登录"
          },
          {
            "value": "2",
            "label": "注册新账号"
          },
          {
            "value": "3",
            "label": "找回密码"
          }
        ],
        "placeholder": "留空则流程内会再次询问"
      }
    ],
    "vars": {
      "base": "https://hdgateway.zto.com",
      "mapi": "https://mapi.zto.com",
      "ua": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
      "token": "",
      "result": "",
      "account": "",
      "message": ""
    },
    "flow": [
      {
        "id": "route",
        "type": "ui",
        "when": "input.mode == ''",
        "ui": {
          "type": "select",
          "label": "请选择操作",
          "input": "mode",
          "options": [
            {
              "value": "1",
              "label": "密码登录"
            },
            {
              "value": "2",
              "label": "注册新账号"
            },
            {
              "value": "3",
              "label": "找回密码"
            }
          ],
          "hint": "本步只在表单未选择模式时出现"
        }
      },
      {
        "id": "askLoginUser",
        "type": "ui",
        "when": "input.mode == '1'",
        "ui": {
          "type": "text",
          "label": "中通账号",
          "input": "userName",
          "maxLength": 32,
          "hint": "手机号 / 会员名"
        }
      },
      {
        "id": "askLoginPwd",
        "type": "ui",
        "when": "input.mode == '1'",
        "ui": {
          "type": "text",
          "label": "登录密码",
          "input": "password",
          "maxLength": 64,
          "hint": "该键在 inputs 中声明为 password+sensitive，宿主会掩码显示"
        }
      },
      {
        "id": "login",
        "type": "request",
        "when": "input.mode == '1'",
        "request": {
          "method": "POST",
          "url": "{{vars.base}}/auth_account_loginByPassword",
          "headers": {
            "User-Agent": "{{vars.ua}}",
            "Origin": "https://auth.zto.com",
            "Referer": "https://auth.zto.com/",
            "Content-Type": "application/json;charset=UTF-8",
            "x-clientCode": "pc",
            "x-token": ""
          },
          "body": {
            "type": "json",
            "value": {
              "userName": "{{input.userName}}",
              "password": "{{input.password}}",
              "isAgainBind": false
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "token",
            "from": "json",
            "path": "$.result.token",
            "optional": true,
            "default": ""
          },
          {
            "name": "status",
            "from": "json",
            "path": "$.status",
            "optional": true,
            "default": ""
          },
          {
            "name": "message",
            "from": "json",
            "path": "$.message",
            "optional": true,
            "default": ""
          },
          {
            "name": "statusCode",
            "from": "json",
            "path": "$.statusCode",
            "optional": true,
            "default": ""
          }
        ]
      },
      {
        "id": "loginCheck",
        "type": "set",
        "when": "(input.mode == '1') && (steps.login.status != true)",
        "set": {
          "vars": {
            "abortFlag": "{{fn.hex(fn.unhex('zz'))}}"
          }
        },
        "onFail": {
          "message": "中通登录失败：{{steps.login.message}}（statusCode={{steps.login.statusCode}}）"
        },
        "goto": "loginDone"
      },
      {
        "id": "loginDone",
        "type": "set",
        "when": "input.mode == '1'",
        "end": true,
        "set": {
          "vars": {
            "token": "{{steps.login.token}}",
            "result": "登录成功",
            "account": "{{input.userName}}",
            "message": "{{steps.login.message}}"
          }
        }
      },
      {
        "id": "regMobile",
        "type": "ui",
        "when": "input.mode == '2'",
        "ui": {
          "type": "text",
          "label": "注册 · 手机号",
          "input": "mobile",
          "maxLength": 11,
          "pattern": "^1\\d{10}$",
          "hint": "请输入 11 位手机号"
        }
      },
      {
        "id": "forgotMobile",
        "type": "ui",
        "when": "input.mode == '3'",
        "ui": {
          "type": "text",
          "label": "找回密码 · 手机号",
          "input": "mobile",
          "maxLength": 11,
          "pattern": "^1\\d{10}$",
          "hint": "请输入要找回密码的 11 位手机号"
        }
      },
      {
        "id": "getCaptcha",
        "type": "request",
        "when": "input.mode != '1'",
        "branch": [
          {
            "when": "input.mode == '2' && steps.getCaptcha.channel == 'original' && steps.getCaptcha.image != ''",
            "goto": "regAskPicCaptcha"
          },
          {
            "when": "input.mode == '3' && steps.getCaptcha.channel == 'original' && steps.getCaptcha.image != ''",
            "goto": "forgotAskPicCaptcha"
          },
          {
            "when": "input.mode == '2'",
            "goto": "regAskCaptcha"
          },
          {
            "when": "input.mode == '3'",
            "goto": "forgotAskCaptcha"
          }
        ],
        "request": {
          "method": "POST",
          "url": "{{vars.mapi}}/captcha/image2",
          "headers": {
            "User-Agent": "{{vars.ua}}",
            "Origin": "https://auth.zto.com",
            "Referer": "https://auth.zto.com/",
            "Content-Type": "application/json;charset=UTF-8",
            "x-clientCode": "pc",
            "x-token": ""
          },
          "body": {
            "type": "json",
            "value": {}
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "id",
            "from": "json",
            "path": "$.result.id",
            "optional": true,
            "default": ""
          },
          {
            "name": "image",
            "from": "json",
            "path": "$.result.image",
            "optional": true,
            "default": ""
          },
          {
            "name": "channel",
            "from": "json",
            "path": "$.result.channel",
            "optional": true,
            "default": ""
          },
          {
            "name": "status",
            "from": "json",
            "path": "$.status",
            "optional": true,
            "default": ""
          },
          {
            "name": "message",
            "from": "json",
            "path": "$.message",
            "optional": true,
            "default": ""
          },
          {
            "name": "statusCode",
            "from": "json",
            "path": "$.statusCode",
            "optional": true,
            "default": ""
          }
        ]
      },
      {
        "id": "getCaptchaCheck",
        "type": "set",
        "when": "(input.mode != '1') && (steps.getCaptcha.status != true)",
        "set": {
          "vars": {
            "abortFlag": "{{fn.hex(fn.unhex('zz'))}}"
          }
        },
        "onFail": {
          "message": "图形验证码获取失败：{{steps.getCaptcha.message}}（statusCode={{steps.getCaptcha.statusCode}}）"
        }
      },
      {
        "id": "regAskPicCaptcha",
        "type": "ui",
        "when": "input.mode == '2'",
        "ui": {
          "type": "image",
          "label": "图形验证码",
          "input": "captchaCode",
          "maxLength": 8,
          "image": "{{steps.getCaptcha.image}}",
          "refreshStep": "getCaptcha",
          "hint": "请输入图片中的字符（看不清可点击刷新）"
        },
        "branch": [
          {
            "when": "input.captchaCode == '刷新'",
            "goto": "getCaptcha"
          }
        ]
      },
      {
        "id": "regAskCaptcha",
        "type": "ui",
        "when": "input.mode == '2' && !(steps.getCaptcha.channel == 'original' && steps.getCaptcha.image != '')",
        "ui": {
          "type": "webview",
          "label": "注册 · 安全验证（滑动完成验证）",
          "input": "captchaCode",
          "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<script src=\"https://cdn.dingxiang-inc.com/ctu-group/captcha-ui/v5/index.js\" crossorigin=\"anonymous\"></script>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\n  html, body { width: 100%; height: 100%; background-color: transparent; overflow: hidden;\n    display: flex; justify-content: center; align-items: center;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; }\n  #dxMount { width: 300px; height: 295px; display: flex; justify-content: center;\n    align-items: center; position: relative; }\n  .dx_captcha { position: static !important; margin: 0 auto !important;\n    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28) !important;\n    border-radius: 16px !important; }\n  .dx_captcha_basic_tr-btn-close { display: none !important; }\n  .dx_captcha_loading_overlay { display: none !important; }\n</style>\n</head>\n<body>\n<div id=\"dxMount\"></div>\n<script>\n  window.onload = function() {\n    try {\n      var cap = _dx.Captcha(document.getElementById('dxMount'), {\n        appId: '12b955c66f4182ea4c3566592b1d87be',\n        apiServer: 'https://cap-8.dingxiang-inc.com',\n        style: 'popup',\n        width: 300,\n        success: function(token) {\n          if (window.FlutterBridge && window.FlutterBridge.postMessage) {\n            window.FlutterBridge.postMessage(JSON.stringify({action: 'success', value: token}));\n          }\n        },\n        fail: function(err) {},\n        hide: function() {\n          if (window.FlutterBridge && window.FlutterBridge.postMessage) {\n            window.FlutterBridge.postMessage(JSON.stringify({action: 'close'}));\n          }\n        }\n      });\n      cap.show();\n    } catch (e) {}\n  };\n</script>\n</body>\n</html>",
          "baseUrl": "https://hdgateway.zto.com/",
          "hint": "拖动滑块完成验证；验证通过后会自动继续"
        }
      },
      {
        "id": "regSendCode",
        "type": "request",
        "when": "input.mode == '2'",
        "request": {
          "method": "POST",
          "url": "{{vars.base}}/auth_account_sendRegisterSmsVerifyCode",
          "headers": {
            "User-Agent": "{{vars.ua}}",
            "Origin": "https://auth.zto.com",
            "Referer": "https://auth.zto.com/",
            "Content-Type": "application/json;charset=UTF-8",
            "x-clientCode": "pc",
            "x-token": "",
            "x-captcha-id": "{{steps.getCaptcha.id}}",
            "x-captcha-code": "{{input.captchaCode}}"
          },
          "body": {
            "type": "json",
            "value": {
              "mobile": "{{input.mobile}}"
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "status",
            "from": "json",
            "path": "$.status",
            "optional": true,
            "default": ""
          },
          {
            "name": "message",
            "from": "json",
            "path": "$.message",
            "optional": true,
            "default": ""
          },
          {
            "name": "statusCode",
            "from": "json",
            "path": "$.statusCode",
            "optional": true,
            "default": ""
          }
        ]
      },
      {
        "id": "regSendCodeCheck",
        "type": "set",
        "when": "(input.mode == '2') && (steps.regSendCode.status != true)",
        "set": {
          "vars": {
            "abortFlag": "{{fn.hex(fn.unhex('zz'))}}"
          }
        },
        "onFail": {
          "message": "注册短信发送失败：{{steps.regSendCode.message}}（statusCode={{steps.regSendCode.statusCode}}）"
        }
      },
      {
        "id": "regAskSms",
        "type": "ui",
        "when": "input.mode == '2'",
        "ui": {
          "type": "text",
          "label": "注册 · 短信验证码",
          "input": "smsCode",
          "maxLength": 6,
          "pattern": "^\\d{6}$",
          "hint": "短信验证码已发送，请输入 6 位数字验证码"
        }
      },
      {
        "id": "regNewPwd",
        "type": "ui",
        "when": "input.mode == '2'",
        "ui": {
          "type": "text",
          "label": "注册 · 设置新密码（至少 8 位）",
          "input": "newPassword",
          "maxLength": 64,
          "pattern": "^.{8,}$",
          "hint": "密码至少 8 位"
        }
      },
      {
        "id": "regNewPwd2",
        "type": "ui",
        "when": "input.mode == '2'",
        "branch": [
          {
            "when": "input.newPassword != input.newPassword2",
            "goto": "regNewPwd2"
          }
        ],
        "ui": {
          "type": "text",
          "label": "注册 · 再次输入新密码",
          "input": "newPassword2",
          "maxLength": 64,
          "pattern": "^.{8,}$",
          "hint": "两次输入必须一致；不一致会重新询问本次输入"
        }
      },
      {
        "id": "regSubmit",
        "type": "request",
        "when": "input.mode == '2'",
        "request": {
          "method": "POST",
          "url": "{{vars.base}}/auth_account_registerBySmsVerifyCode",
          "headers": {
            "User-Agent": "{{vars.ua}}",
            "Origin": "https://auth.zto.com",
            "Referer": "https://auth.zto.com/",
            "Content-Type": "application/json;charset=UTF-8",
            "x-clientCode": "pc",
            "x-token": ""
          },
          "body": {
            "type": "json",
            "value": {
              "mobile": "{{input.mobile}}",
              "verifyCode": "{{input.smsCode}}",
              "password": "{{input.newPassword}}"
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "status",
            "from": "json",
            "path": "$.status",
            "optional": true,
            "default": ""
          },
          {
            "name": "message",
            "from": "json",
            "path": "$.message",
            "optional": true,
            "default": ""
          },
          {
            "name": "statusCode",
            "from": "json",
            "path": "$.statusCode",
            "optional": true,
            "default": ""
          }
        ]
      },
      {
        "id": "regSubmitCheck",
        "type": "set",
        "when": "(input.mode == '2') && (steps.regSubmit.status != true)",
        "set": {
          "vars": {
            "abortFlag": "{{fn.hex(fn.unhex('zz'))}}"
          }
        },
        "onFail": {
          "message": "注册失败：{{steps.regSubmit.message}}（statusCode={{steps.regSubmit.statusCode}}）"
        },
        "goto": "regDone"
      },
      {
        "id": "regDone",
        "type": "set",
        "when": "input.mode == '2'",
        "end": true,
        "set": {
          "vars": {
            "result": "注册成功",
            "account": "{{input.mobile}}",
            "message": "{{steps.regSubmit.message}}"
          }
        }
      },
      {
        "id": "forgotAskPicCaptcha",
        "type": "ui",
        "when": "input.mode == '3'",
        "ui": {
          "type": "image",
          "label": "图形验证码",
          "input": "captchaCode",
          "maxLength": 8,
          "image": "{{steps.getCaptcha.image}}",
          "refreshStep": "getCaptcha",
          "hint": "请输入图片中的字符（看不清可点击刷新）"
        },
        "branch": [
          {
            "when": "input.captchaCode == '刷新'",
            "goto": "getCaptcha"
          }
        ]
      },
      {
        "id": "forgotAskCaptcha",
        "type": "ui",
        "when": "input.mode == '3' && !(steps.getCaptcha.channel == 'original' && steps.getCaptcha.image != '')",
        "ui": {
          "type": "webview",
          "label": "找回密码 · 安全验证（滑动完成验证）",
          "input": "captchaCode",
          "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<script src=\"https://cdn.dingxiang-inc.com/ctu-group/captcha-ui/v5/index.js\" crossorigin=\"anonymous\"></script>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\n  html, body { width: 100%; height: 100%; background-color: transparent; overflow: hidden;\n    display: flex; justify-content: center; align-items: center;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif; }\n  #dxMount { width: 300px; height: 295px; display: flex; justify-content: center;\n    align-items: center; position: relative; }\n  .dx_captcha { position: static !important; margin: 0 auto !important;\n    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28) !important;\n    border-radius: 16px !important; }\n  .dx_captcha_basic_tr-btn-close { display: none !important; }\n  .dx_captcha_loading_overlay { display: none !important; }\n</style>\n</head>\n<body>\n<div id=\"dxMount\"></div>\n<script>\n  window.onload = function() {\n    try {\n      var cap = _dx.Captcha(document.getElementById('dxMount'), {\n        appId: '12b955c66f4182ea4c3566592b1d87be',\n        apiServer: 'https://cap-8.dingxiang-inc.com',\n        style: 'popup',\n        width: 300,\n        success: function(token) {\n          if (window.FlutterBridge && window.FlutterBridge.postMessage) {\n            window.FlutterBridge.postMessage(JSON.stringify({action: 'success', value: token}));\n          }\n        },\n        fail: function(err) {},\n        hide: function() {\n          if (window.FlutterBridge && window.FlutterBridge.postMessage) {\n            window.FlutterBridge.postMessage(JSON.stringify({action: 'close'}));\n          }\n        }\n      });\n      cap.show();\n    } catch (e) {}\n  };\n</script>\n</body>\n</html>",
          "baseUrl": "https://hdgateway.zto.com/",
          "hint": "拖动滑块完成验证；验证通过后会自动继续"
        }
      },
      {
        "id": "forgotSendCode",
        "type": "request",
        "when": "input.mode == '3'",
        "request": {
          "method": "POST",
          "url": "{{vars.base}}/auth_account_sendForgotPasswordVerifyCode",
          "headers": {
            "User-Agent": "{{vars.ua}}",
            "Origin": "https://auth.zto.com",
            "Referer": "https://auth.zto.com/",
            "Content-Type": "application/json;charset=UTF-8",
            "x-clientCode": "pc",
            "x-token": "",
            "x-captcha-id": "{{steps.getCaptcha.id}}",
            "x-captcha-code": "{{input.captchaCode}}"
          },
          "body": {
            "type": "json",
            "value": {
              "twoFactorVerifyType": "sms",
              "userName": "{{input.mobile}}"
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "status",
            "from": "json",
            "path": "$.status",
            "optional": true,
            "default": ""
          },
          {
            "name": "message",
            "from": "json",
            "path": "$.message",
            "optional": true,
            "default": ""
          },
          {
            "name": "statusCode",
            "from": "json",
            "path": "$.statusCode",
            "optional": true,
            "default": ""
          }
        ]
      },
      {
        "id": "forgotSendCodeCheck",
        "type": "set",
        "when": "(input.mode == '3') && (steps.forgotSendCode.status != true)",
        "set": {
          "vars": {
            "abortFlag": "{{fn.hex(fn.unhex('zz'))}}"
          }
        },
        "onFail": {
          "message": "找回密码短信发送失败：{{steps.forgotSendCode.message}}（statusCode={{steps.forgotSendCode.statusCode}}）"
        }
      },
      {
        "id": "forgotAskSms",
        "type": "ui",
        "when": "input.mode == '3'",
        "ui": {
          "type": "text",
          "label": "找回密码 · 短信验证码",
          "input": "smsCode",
          "maxLength": 6,
          "pattern": "^\\d{6}$",
          "hint": "短信验证码已发送，请输入 6 位数字验证码"
        }
      },
      {
        "id": "forgotVerify",
        "type": "request",
        "when": "input.mode == '3'",
        "request": {
          "method": "POST",
          "url": "{{vars.base}}/auth_account_checkForgotPasswordVerifyCode",
          "headers": {
            "User-Agent": "{{vars.ua}}",
            "Origin": "https://auth.zto.com",
            "Referer": "https://auth.zto.com/",
            "Content-Type": "application/json;charset=UTF-8",
            "x-clientCode": "pc",
            "x-token": ""
          },
          "body": {
            "type": "json",
            "value": {
              "twoFactorVerifyType": "sms",
              "twoFactorVerifyCode": "{{input.smsCode}}",
              "userName": "{{input.mobile}}"
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "status",
            "from": "json",
            "path": "$.status",
            "optional": true,
            "default": ""
          },
          {
            "name": "message",
            "from": "json",
            "path": "$.message",
            "optional": true,
            "default": ""
          },
          {
            "name": "statusCode",
            "from": "json",
            "path": "$.statusCode",
            "optional": true,
            "default": ""
          }
        ]
      },
      {
        "id": "forgotVerifyCheck",
        "type": "set",
        "when": "(input.mode == '3') && (steps.forgotVerify.status != true)",
        "set": {
          "vars": {
            "abortFlag": "{{fn.hex(fn.unhex('zz'))}}"
          }
        },
        "onFail": {
          "message": "短信验证码校验失败：{{steps.forgotVerify.message}}（statusCode={{steps.forgotVerify.statusCode}}）"
        }
      },
      {
        "id": "forgotNewPwd",
        "type": "ui",
        "when": "input.mode == '3'",
        "ui": {
          "type": "text",
          "label": "找回密码 · 设置新密码（至少 8 位）",
          "input": "newPassword",
          "maxLength": 64,
          "pattern": "^.{8,}$",
          "hint": "新密码至少 8 位"
        }
      },
      {
        "id": "forgotNewPwd2",
        "type": "ui",
        "when": "input.mode == '3'",
        "branch": [
          {
            "when": "input.newPassword != input.newPassword2",
            "goto": "forgotNewPwd2"
          }
        ],
        "ui": {
          "type": "text",
          "label": "找回密码 · 再次输入新密码",
          "input": "newPassword2",
          "maxLength": 64,
          "pattern": "^.{8,}$",
          "hint": "两次输入必须一致；不一致会重新询问本次输入"
        }
      },
      {
        "id": "forgotReset",
        "type": "request",
        "when": "input.mode == '3'",
        "request": {
          "method": "POST",
          "url": "{{vars.base}}/auth_account_forgotPasswordByVerifyCode",
          "headers": {
            "User-Agent": "{{vars.ua}}",
            "Origin": "https://auth.zto.com",
            "Referer": "https://auth.zto.com/",
            "Content-Type": "application/json;charset=UTF-8",
            "x-clientCode": "pc",
            "x-token": ""
          },
          "body": {
            "type": "json",
            "value": {
              "twoFactorVerifyType": "sms",
              "twoFactorVerifyCode": "{{input.smsCode}}",
              "userName": "{{input.mobile}}",
              "newPassword": "{{input.newPassword}}"
            }
          },
          "timeoutMs": 20000
        },
        "extract": [
          {
            "name": "status",
            "from": "json",
            "path": "$.status",
            "optional": true,
            "default": ""
          },
          {
            "name": "message",
            "from": "json",
            "path": "$.message",
            "optional": true,
            "default": ""
          },
          {
            "name": "statusCode",
            "from": "json",
            "path": "$.statusCode",
            "optional": true,
            "default": ""
          }
        ]
      },
      {
        "id": "forgotResetCheck",
        "type": "set",
        "when": "(input.mode == '3') && (steps.forgotReset.status != true)",
        "set": {
          "vars": {
            "abortFlag": "{{fn.hex(fn.unhex('zz'))}}"
          }
        },
        "onFail": {
          "message": "密码重置失败：{{steps.forgotReset.message}}（statusCode={{steps.forgotReset.statusCode}}）"
        },
        "goto": "forgotDone"
      },
      {
        "id": "forgotDone",
        "type": "set",
        "when": "input.mode == '3'",
        "end": true,
        "set": {
          "vars": {
            "result": "密码重置成功",
            "account": "{{input.mobile}}",
            "message": "{{steps.forgotReset.message}}"
          }
        }
      }
    ],
    "output": {
      "title": "中通会员凭证",
      "fields": [
        {
          "label": "Token（登录模式）",
          "value": "{{vars.token}}",
          "copyable": true,
          "sensitive": true,
          "multiline": false
        },
        {
          "label": "操作结果",
          "value": "{{vars.result}}",
          "copyable": true,
          "sensitive": false,
          "multiline": false
        },
        {
          "label": "账号 / 手机号",
          "value": "{{vars.account}}",
          "copyable": true,
          "sensitive": false,
          "multiline": false
        },
        {
          "label": "服务端消息",
          "value": "{{vars.message}}",
          "copyable": true,
          "sensitive": false,
          "multiline": false
        }
      ]
    }
  },
  "meta": {
    "exportedAt": "2026-10-26T17:30:00Z",
    "exportedBy": "tool-plugin v1.0"
  }
}